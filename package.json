{
  "name": "PiggyPath",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "node scripts/android.cjs --active-arch-only",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "node scripts/start.cjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write App.tsx src __tests__ scripts",
    "sync-config": "node scripts/sync-config.cjs",
    "preandroid": "npm run sync-config",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand",
    "start:metro": "react-native start",
    "emulators": "node scripts/start.cjs --list-emulators",
    "android:release": "npm run sync-config && node scripts/android.cjs --build-release"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@op-engineering/op-sqlite": "^18.2.5",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "lucide-react-native": "^1.49.0",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "PiggyPathCryptoSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.ipongoal.crypto"
    }
  }
}
